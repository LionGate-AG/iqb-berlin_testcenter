VERSION=stable

COMPOSE_PROJECT_NAME=testcenter

# Ingress
HOSTNAME=localhost
HTTP_PORT=80
HTTPS_PORT=443
TLS_ENABLED=true
# Strict-Transport-Security response header
HSTS_ENABLED=true

# TLS Certificates Resolvers
## Choose '', if you handle certificates manually, or
## choose 'acme', if you want to use an ACME provider, like 'Let's Encrypt' or 'Sectigo'
TLS_CERTIFICATE_RESOLVER=
TLS_ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
TLS_ACME_EAB_KID=
TLS_ACME_EAB_HMAC_ENCODED=
TLS_ACME_EMAIL=admin.name@organisation.org

# Images
## Dockerhub Proxy
DOCKERHUB_PROXY=
## Container Restart Policy. Allowed values are: no, always (default), on-failure, unless-stopped
RESTART_POLICY=always

# Services
## Backend
BROADCASTER_ENABLED=true
FILE_SERVER_ENABLED=true
### Logins protected against brute force attacks by a proof-of-work challenge (admin, login, person), separated by
### spaces. Empty disables the protection.
### IMPORTANT: Browsers must reach the Testcenter via HTTPS (TLS_ENABLED=true or a
### TLS-terminating proxy), otherwise the protected logins are impossible.
BRUTE_FORCE_PROTECTION=
### Validate uploaded XML files against their XSD schema. Default is true.
XML_SCHEMA_VALIDATION=true
PASSWORD_SALT=t
SERVER_KEY=Secret
PASSWORD_MIN_LENGTH=7
PASSWORD_PATTERN=^.*$
## Refuse logins without password (except sys-check logins) and report them as errors in Testtakers files
REQUIRE_LOGIN_PASSWORD=false
ADMIN_INIT_PASSWORD=user123

## Cache Service
### Also protects the broadcaster's Redis (broadcaster-redis)
REDIS_PASSWORD=change_me
### Allowed memory usage for cache in byte. 2147483648 = 2GB. Default is 1GB.
REDIS_MEMORY_MAX=1gb
### Should whole files be cached or only authentication tokens
REDIS_CACHE_FILES=false
### Serve the session-token lookup of test-takers from the cache instead of the database (for large
### installations, see the documentation page "Scaling: Auth-Token Cache"). Default is false.
TESTCENTER_CACHE_AUTH_TOKEN=false
### Maximum time in seconds a cached token is served without asking the database. 0 disables the cache. Default is 300.
TESTCENTER_AUTH_TOKEN_TTL=300
### Queue the test logs in the cache and let the service log-drainer write them to the database in batches, instead
### of one insert per request (for large installations, see the documentation page "Scaling: Async Test Logs").
### Logs still queued are lost when the cache service restarts. Default is false.
TESTCENTER_ASYNC_TEST_LOGS=false
### Settings of the log-drainer: rows per insert (default 5000, at most 21845), pause in milliseconds when the queue
### is empty (default 200), seconds between two status lines in its log (default 30)
LOG_DRAIN_BATCH=5000
LOG_DRAIN_IDLE_MS=200
LOG_DRAIN_REPORT_SEC=30

## Database
DB_DATABASE=iqb_tba_testcenter
DB_USER=iqb_tba_db_user
DB_PASSWORD=iqb_tba_db_password
### Keep one database connection per backend worker process open across requests instead of opening a new one per
### request. Every worker then holds a connection while it exists, also when idle. Default is false.
DB_PERSISTENT_CONNECTIONS=false
### Host the backend connects to. "db" is PostgreSQL itself. "pgbouncer" uses the optional PgBouncer connection pooler,
### which additionally requires COMPOSE_PROFILES=pgbouncer. See docs/site/pages/scaling-connection-pooling.md.
DB_HOST=db
#COMPOSE_PROFILES=pgbouncer

# Network
## MTU Setting. Default is 1500, but Openstack actually uses 1442
DOCKER_DAEMON_MTU=1500
